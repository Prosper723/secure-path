# ── Secrets: never commit these ─────────────────────────────────────────────
.streamlit/secrets.toml
.env
.env.*
*.key

# ── Raw FCDO lists: they name diplomats and their spouses ───────────────────
# Download them from GOV.UK when you need to rebuild missions.json
# (see "Updating embassy contacts" in the README). missions.json itself
# contains only public office details and IS committed.
tools/fcdo_lists/*.odt
tools/fcdo_lists/*.ods
tools/fcdo_lists/*.docx
tools/fcdo_lists/archive/
tools/fcdo_lists/gov_uk_state.json
tools/source_fingerprints.json

# ── Python / tooling clutter ────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.DS_Store
Thumbs.db
